{
  // Hosted Project Inbox on Cloudflare. The local `npx project-inbox` app does not use this folder.
  "name": "project-inbox",
  "main": "../src/app.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "../public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "project-inbox", "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create", "migrations_dir": "../migrations" }
  ],
  "vars": {
    "AUTH_MODE": "google",
    "ALLOWED_EMAILS": "you@example.com"
  }
  // Secrets, set with `wrangler secret put`: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET, CREDENTIALS_KEY
}
