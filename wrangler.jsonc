// Hosted Project Inbox on Cloudflare Workers. Not used by the local app (npx project-inbox).
// Setup and secrets: docs/cloudflare.md
{
  "name": "project-inbox",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker answers every request first so it can check access and set security headers, then serves ./public.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-inbox",
      // Replace with the id printed by: npx wrangler d1 create project-inbox
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Fallback sync for mail whose webhook was missed. Webhooks make new mail appear within seconds.
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "HOSTED": "true" },
  "observability": { "enabled": true }
}
